#!/usr/bin/env bash
# Vistal command-line entry point.
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
root="$(dirname "$(dirname "$self")")"

# Frontends packaged as AppImages (ES-DE) can leak their bundled libraries
# into child processes; Proton and Python must not see them.
if [ -n "${APPDIR:-}" ] && [ -n "${LD_LIBRARY_PATH:-}" ]; then
    cleaned=""
    IFS=':' read -r -a parts <<< "$LD_LIBRARY_PATH"
    for p in "${parts[@]}"; do
        case "$p" in "$APPDIR"*|"") ;; *) cleaned="${cleaned:+$cleaned:}$p" ;; esac
    done
    if [ -n "$cleaned" ]; then export LD_LIBRARY_PATH="$cleaned"; else unset LD_LIBRARY_PATH; fi
fi
unset PYTHONHOME

python="${VISTAL_PYTHON:-}"
if [ -z "$python" ]; then
    for cand in python3 /usr/bin/python3 python3.13 python3.12 python3.11; do
        if command -v "$cand" >/dev/null 2>&1 && \
           "$cand" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
            python="$cand"
            break
        fi
    done
fi
if [ -z "$python" ]; then
    echo "vistal: Python 3.11 or newer is required" >&2
    exit 1
fi

export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec "$python" -m vistal "$@"
